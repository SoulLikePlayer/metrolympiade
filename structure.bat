src/
├── App.vue  # Point d'entrée principal de l'application Vue.js
├── main.js  # Initialise l'application et monte Vue
├── api/  # Gestion des appels API
├── assets/  # Ressources statiques (images, styles, etc.)
│   ├── img/  # Images du projet
│   ├── style/  # Fichiers CSS globaux
│   │   └── style.css  # Style principal de l'application
├── components/  # Composants réutilisables de l'application
├── composables/  # Fonctions réutilisables sous forme de composables Vue
├── layout/  # Composants de mise en page (Header, Footer, etc.)
├── pages/  # Pages principales de l'application
├── router/  # Configuration des routes avec Vue Router
├── store/  # Gestion de l'état global (Vuex ou Pinia)
